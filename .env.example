# LavaLust Docker Environment Configuration

# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Database (Match docker-compose.yml values)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=silla_isiah_james_act4_db
DB_USER=silla_isiah_james_act4_user
DB_PASSWORD=silla_isiah_james_act4_pass

# For development, you can also use root
# DB_USER=root
# DB_PASSWORD=root

# Session
SESSION_DRIVER=file
SESSION_PATH=/var/www/html/runtime

# Timezone
APP_TIMEZONE=UTC
